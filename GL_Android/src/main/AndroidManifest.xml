<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 인앱 업데이트: APK 다운로드 후 설치 요청 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 로컬 알림(출석·예산·재화) — Android 13+ 런타임 권한 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 자동 출석 백그라운드 안정성: 도즈/스탠바이로 워커가 며칠씩 막히는 케이스 회복용
         배터리 최적화 화이트리스트 등록 요청(사용자 확인 다이얼로그). Play 정책상 "필수 백그라운드 작업"
         (일일 출석)에 해당하므로 명시적으로 요청 가능. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Android 11+ 패키지 가시성 — 외부 링크(브라우저·지도 앱)를 조회/실행하려면 명시가 필요하다.
         선언이 없으면 resolveActivity 가 null 을 돌려줘 링크 열기가 조용히 실패할 수 있다. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <application
        android:name=".GatchaApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Gatcha LOG"
        android:supportsRtl="true"
        android:theme="@style/Theme.GatchaLog">
        <!--
          launchMode=singleTask — 알림을 탭할 때마다 앱이 새로 켜지던 문제.
          기본(standard)이면 알림 인텐트가 MainActivity 를 **새 인스턴스**로 띄운다. 그러면 화면 상태가
          초기화돼(로딩 게이트부터 다시) 사용자 눈엔 앱이 재시작한 것처럼 보인다.
          singleTask 면 이미 떠 있는 인스턴스를 그대로 되살리고 onNewIntent 로 인텐트만 전달한다.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:theme="@style/Theme.GatchaLog.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 웹 OAuth(PKCE) 리다이렉트 수신 — Google 로그인 콜백 스킴 -->
        <activity
            android:name=".auth.OAuthRedirectActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.googleusercontent.apps.711708512022-6upq632okh78jru6q09o2dol4tekokbn" />
            </intent-filter>
        </activity>

        <!-- PackageInstaller 설치 결과 수신 (앱 내부 전용) -->
        <receiver
            android:name=".data.api.InstallResultReceiver"
            android:exported="false" />
    </application>

</manifest>
