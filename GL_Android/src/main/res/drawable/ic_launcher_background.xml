<?xml version="1.0" encoding="utf-8"?>
<!--
  앱 아이콘 배경 — W4(화이트 + 민트 글로우). v27.38.0 개편.
  순백만 두면 밝은 배경화면 위에서 아이콘 경계가 녹는다(홈화면 아이콘엔 시스템 그림자가 거의 없음).
  중앙에 은은한 민트 광채를 깔아 테두리 없이도 아이콘 영역이 인지되게 한다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 화이트 바탕 -->
    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#FFFFFFFF" />

    <!-- 민트 글로우 (중앙 → 가장자리로 소멸, alpha 0.18 → 0) -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="56"
                android:gradientRadius="60"
                android:startColor="#2E34D1B6"
                android:endColor="#0034D1B6" />
        </aapt:attr>
    </path>
</vector>
