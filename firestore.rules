rules_version = '2';

// ============================================================
// Gatcha LOG — Firestore 보안 규칙
//
// 데이터 모델: users/{uid} 문서 하나에 사용자별 전체 스냅샷 저장
//   - data       : 가챠·지출 전체 스냅샷(평문 JSON 문자열) — 읽기의 단일 소스
//   - updatedAt   : 갱신 시각(epoch millis)
//   (CloudSync.kt 의 COLLECTION="users", FIELD_DATA="data")
//
//   ⚠️ 예전엔 userInfo/spending/gameInfo 섹션 맵을 함께 썼다(dual-write). 읽는 쪽이 없는데
//   문서를 두 배로 불려 1MiB 한도를 절반만 쓰게 만들어 걷어냈다. set 이 문서를 통째로
//   교체하므로 남아 있던 섹션 필드는 다음 push 에서 사라진다.
//
// 원칙: "구글 계정 귀속" — 본인(uid) 문서만 읽고 쓸 수 있다.
//   · 비로그인 → 전면 차단
//   · 로그인했어도 남의 uid 문서 → 차단 (request.auth.uid == uid 강제)
//
// 배포:  firebase deploy --only firestore:rules
// 콘솔:  Firebase Console → Firestore Database → 규칙 탭에 동일 내용
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // 사용자별 클라우드 스냅샷 — 소유자 본인만 접근
    match /users/{uid} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

    // ── 운영 설정 — 어드민이 쓰고 앱 전체가 읽는다 ──────────────────
    //
    // 읽기가 공개인 이유: 호요랜드 화면은 로그인과 무관한 읽기 전용 소개 페이지다
    // (HoyolandApi.fetchLive). 비로그인 사용자도 행사 정보를 봐야 하므로 인증을 걸 수 없다.
    // 담기는 내용은 이미 GitHub raw 로 전세계 공개된 hoyoland.json 과 동일하다 —
    // ⚠️ 그러므로 이 문서에는 비공개 값을 절대 넣지 않는다.
    //
    // 쓰기는 운영자 uid 화이트리스트로 막는다. 커스텀 클레임은 Functions(유료 플랜)가
    // 필요해서 과하고, 문서 기반 역할 조회는 규칙 평가마다 읽기가 한 번 더 든다.
    // uid 확인: Firebase Console → Authentication → 사용자, 또는 앱 개발자 화면.
    match /config/{doc} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid in [
                        'kc6zQnqGCseoL0yHKNwmqriO23j2'  // 운영자
                      ];
    }

    // 그 외 모든 경로.
    //
    // ⚠️ 이 블록이 막아 주는 것이 아니다. Firestore 규칙에는 **deny 문법이 없고**, 규칙은
    // OR 로 평가되어 매칭되는 allow 가 하나라도 있으면 허용된다. 실제로 막는 것은
    // "매칭되는 allow 가 없다" 는 사실이고, 아래 `if false` 는 아무것도 허용하지 않는다는
    // 뜻일 뿐이다(위의 allow 를 취소하지 못한다).
    //
    // 그래도 남겨 두는 이유: 새 경로를 열 때 **여기 말고 위쪽에 블록을 더한다**는 것을
    // 눈으로 알리는 표지다. 여기에 allow 를 적으면 전 경로가 열린다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
