#!/bin/sh
# 이 저장소 전용 pre-commit.
#
# core.hooksPath 를 여기로 돌리면 **전역 훅이 안 돈다.** 전역 pre-commit 에는 개인/회사 계정
# 교차 오염을 막는 가드가 들어 있어 빠지면 안 되므로, 우리 검사를 먼저 하고 마지막에 넘긴다.
set -e
"$(dirname "$0")/check-version-json.sh"

globals=$(git config --global core.hooksPath 2>/dev/null || true)
if [ -n "$globals" ]; then
  case "$globals" in "~"*) globals="$HOME${globals#\~}" ;; esac
  if [ -x "$globals/pre-commit" ]; then exec "$globals/pre-commit"; fi
fi
exit 0
